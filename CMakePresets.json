{
  "version": 6,
  "configurePresets": [
    {
      "name": "config-base-vcpkg",
      "hidden": true,
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-ports"
      }
    },
    {
      "name": "config-base-cmake",
      "hidden": true,
      "binaryDir": "${sourceDir}/bin/${presetName}",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELEASE": "TRUE"
      }
    },
    {
      "name": "config-base-ninja",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "/MP /diagnostics:caret",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>"
      }
    },
    {
      "name": "config-base-msvc2022",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64"
      },
      "inherits": [
        "config-base-ninja"
      ]
    },
    {
      "name": "configuration-final",
      "hidden": true,
      "inherits": [
        "config-base-vcpkg",
        "config-base-cmake",
        "config-base-ninja"
      ]
    },
    {
      "name": "final",
      "inherits": [
        "configuration-final"
      ]
    },
    {
      "name": "test",
      "displayName": "Verification x64",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      },
      "inherits": [
        "final"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "final-debug",
      "configurePreset": "final",
      "configuration": "Debug",
      "displayName": "Final Debug x64"
    },
    {
      "name": "final-release",
      "configurePreset": "final",
      "configuration": "Release",
      "displayName": "Final Release x64"
    },
    {
      "name": "test-debug",
      "configurePreset": "test",
      "configuration": "Debug",
      "displayName": "Verification Debug x64",
      "targets": [
        "AbiTests",
        "SupportTests",
        "Dx12NgxE2ETests",
        "VulkanNgxE2ETests",
        "BackendParityTests",
        "FrameGenerationTestbed"
      ]
    },
    {
      "name": "test-release",
      "configurePreset": "test",
      "configuration": "Release",
      "displayName": "Verification Release x64",
      "targets": [
        "AbiTests",
        "SupportTests",
        "Dx12NgxE2ETests",
        "VulkanNgxE2ETests",
        "BackendParityTests",
        "FrameGenerationTestbed"
      ]
    }
  ],
  "testPresets": [
    {
      "name": "test-debug",
      "configurePreset": "test",
      "configuration": "Debug",
      "displayName": "Verification Debug x64",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-release",
      "configurePreset": "test",
      "configuration": "Release",
      "displayName": "Verification Release x64",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "packagePresets": [
    {
      "name": "final",
      "displayName": "Package Final",
      "configurePreset": "final",
      "packageDirectory": "${sourceDir}/bin/built-packages"
    }
  ]
}
